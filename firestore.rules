rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myRole() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role;
    }
    function isMember() { return signedIn() && myRole() in ['member', 'admin']; }
    function isAdmin()  { return signedIn() && myRole() == 'admin'; }

    // 成員：自己看得到自己；核准的成員看得到全部
    // 新註冊只能把自己建成「待核准」；改身分、移除只有管理員能做
    match /members/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'pending';
      allow update, delete: if isAdmin();
    }

    // 代練單：核准的成員都能看、能改
    match /orders/{orderId} {
      allow read, write: if isMember();
    }

    // 設定：價目表與前台文字「所有人」都能看（前台要用），只有管理員能改
    match /settings/{docId} {
      allow read:  if docId in ['prices', 'site'] || isMember();
      allow write: if isAdmin();
    }

    // 前台委託：任何人都能「新增」（欄位與長度都會檢查），只有成員能看、能改
    match /requests/{reqId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['discord','charName','job','fromLv','toLv','hasTag','quote','unknown','note','status','created'])
                    && request.resource.data.status == 'new'
                    && request.resource.data.discord is string
                    && request.resource.data.discord.size() >= 2 && request.resource.data.discord.size() <= 50
                    && request.resource.data.charName is string && request.resource.data.charName.size() <= 30
                    && request.resource.data.job is string && request.resource.data.job.size() <= 40
                    && request.resource.data.note is string && request.resource.data.note.size() <= 500
                    && request.resource.data.fromLv is int && request.resource.data.toLv is int
                    && request.resource.data.fromLv >= 0 && request.resource.data.toLv > request.resource.data.fromLv
                    && request.resource.data.toLv <= 999
                    && request.resource.data.hasTag is bool
                    && request.resource.data.quote is number && request.resource.data.unknown is int
                    && request.resource.data.created is int;
      allow read, update: if isMember();
      allow delete: if isAdmin();
    }

    // 操作紀錄：只有管理員能看；成員能新增（只能用自己的名義）；任何人都不能修改或刪除
    match /logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
    }
  }
}
